# NeuralEDGE Agent — environment template.
# Copied to ~/.hermes/.env by the installer (only if absent).
# After install, edit ~/.hermes/.env directly. Never commit a real .env.
# File should be chmod 600 — installer enforces this.

# ──────────────────────────────────────────────────────────────────────────
# LLM provider (required) — use the env name that matches your provider.
# Provider is set in ~/.hermes/config.yaml under `model.provider`.
# ──────────────────────────────────────────────────────────────────────────
# OpenRouter — the NeuralEDGE default (model.provider: "auto" or "openrouter")
OPENROUTER_API_KEY=

# Uncomment for alternative providers (and switch model.provider in config.yaml).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# NOUS_API_KEY=
# GOOGLE_API_KEY=
# GITHUB_TOKEN=        # for "copilot" provider

# ──────────────────────────────────────────────────────────────────────────
# Telegram (required for chat channel)
# ──────────────────────────────────────────────────────────────────────────
# Create via @BotFather. Set bot privacy OFF so the bot can read DMs.
# Operator's Telegram user-id is captured during setup.
TELEGRAM_BOT_TOKEN=

# Optional — allowlist of Telegram user-ids that may message Neural.
# If unset, the setup wizard captures and stores the operator's user-id.
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# Optional — pin a "home" channel for status broadcasts and proactive nudges.
# TELEGRAM_HOME_CHANNEL=-1001234567890
# TELEGRAM_HOME_CHANNEL_NAME=Home
# TELEGRAM_HOME_CHANNEL_THREAD_ID=

# ──────────────────────────────────────────────────────────────────────────
# CORTEX-PALACE bridge (NEOS long-term memory)
# ──────────────────────────────────────────────────────────────────────────
# Leave as `stub` until the NEOS CORTEX endpoint is live. In stub mode the
# bridge returns realistic canned data — Neural still functions end-to-end.
CORTEX_MODE=stub
CORTEX_ENDPOINT=
CORTEX_TOKEN=

# Optional tuning. Leave empty for sensible defaults.
CORTEX_TIMEOUT_S=8
CORTEX_BREAKER_THRESHOLD=5
CORTEX_BREAKER_COOLDOWN_S=30

# ──────────────────────────────────────────────────────────────────────────
# n8n.neuraledge.in (optional automations)
# ──────────────────────────────────────────────────────────────────────────
# Either a webhook root the agent posts to, or the n8n MCP URL if exposed.
N8N_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────
# Container UID/GID — match the VPS operator so ~/.hermes is host-readable.
# Upstream's compose defaults to 10000/10000 if unset; we override to the
# host user (set by install.sh from `id -u` / `id -g`).
# ──────────────────────────────────────────────────────────────────────────
HERMES_UID=1000
HERMES_GID=1000

# ──────────────────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata
HERMES_LOG_LEVEL=INFO
