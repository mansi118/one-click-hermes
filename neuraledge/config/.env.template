# NeuralEDGE Agent — environment template.
# Copied to ~/.hermes/.env by the installer (only if absent).
# After install, edit ~/.hermes/.env directly. Never commit a real .env.
# File should be chmod 600 — installer enforces this.

# ──────────────────────────────────────────────────────────────────────────
# LLM provider (required)
# ──────────────────────────────────────────────────────────────────────────
# OpenRouter recommended for flexibility; swap by editing config.yaml provider block.
LLM_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Telegram (required for chat channel)
# ──────────────────────────────────────────────────────────────────────────
# Create via @BotFather. The bot must have privacy mode set so it can read
# direct messages. Operator's Telegram user-id is captured during setup.
TELEGRAM_BOT_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# CORTEX-PALACE bridge
# ──────────────────────────────────────────────────────────────────────────
# Leave as `stub` until the NEOS CORTEX endpoint is live. In stub mode the
# bridge returns realistic canned data — Neural still functions end-to-end.
CORTEX_MODE=stub
CORTEX_ENDPOINT=
CORTEX_TOKEN=

# Optional tuning. Leave empty for sensible defaults.
CORTEX_TIMEOUT_S=8
CORTEX_BREAKER_THRESHOLD=5
CORTEX_BREAKER_COOLDOWN_S=30

# ──────────────────────────────────────────────────────────────────────────
# n8n.neuraledge.in (optional automations)
# ──────────────────────────────────────────────────────────────────────────
# Either a webhook root the agent posts to, or the n8n MCP URL if exposed.
N8N_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────────────────
# Container UID/GID — match the VPS operator so ~/.hermes is host-readable.
# ──────────────────────────────────────────────────────────────────────────
HERMES_UID=1000
HERMES_GID=1000

# ──────────────────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata
HERMES_LOG_LEVEL=INFO
