# Dockerfile.neuraledge — NeuralEDGE overlay on the upstream Hermes image.
#
# The base image is built from the upstream `./Dockerfile` (or pulled from
# a registry once we publish one). This file only COPYs the NeuralEDGE-zone
# artefacts into place — no upstream-code edits.
#
# Build:
#   # 1) Build (or pull) the upstream base first.
#   docker build -t hermes-agent:base .
#   # 2) Build the NeuralEDGE overlay.
#   docker build -t neuraledge/hermes-neuraledge:latest \
#     -f Dockerfile.neuraledge \
#     --build-arg BASE_IMAGE=hermes-agent:base .
#
# Or compose handles both: see docker-compose.neuraledge.yml.

ARG BASE_IMAGE=hermes-agent:base

FROM ${BASE_IMAGE} AS neuraledge

# --- NeuralEDGE branding ----------------------------------------------------
# Banner, theme tokens, strings, persona — read by the branding plugin.
COPY neuraledge/branding/ /opt/app/neuraledge/branding/

# --- Seed skills ------------------------------------------------------------
# Pinned NeuralEDGE skills loaded at boot from skills/neuraledge/.
COPY skills/neuraledge/ /opt/app/skills/neuraledge/

# --- Branding plugin --------------------------------------------------------
# Hermes plugin loader picks this up automatically from plugins/.
COPY plugins/ne_branding/ /opt/app/plugins/ne_branding/

# --- Dashboard theme overlay ------------------------------------------------
COPY web/themes/neuraledge.css /opt/app/web/themes/neuraledge.css

# --- Default config (seeded into ~/.hermes on first run) -------------------
COPY neuraledge/config/ /opt/app/neuraledge/config/

# --- Meta docs (handy to have in-container for `hermes about`) -------------
COPY NEURALEDGE_DESIGN.md NEURALEDGE_BUILD.md NEURALEDGE_PATCHES.md /opt/app/

# Label the image so `docker inspect` confirms it's the branded build.
LABEL org.neuraledge.product="NeuralEDGE Agent" \
      org.neuraledge.short_name="Neural" \
      org.neuraledge.base="hermes-agent" \
      org.opencontainers.image.title="NeuralEDGE Agent (Neural)" \
      org.opencontainers.image.vendor="NeuralEDGE" \
      org.opencontainers.image.source="https://github.com/neuraledge/hermes-agent"

# Default ENV — overrides come from compose / ~/.hermes/.env at runtime.
ENV HERMES_DASHBOARD=1 \
    HERMES_PERSONALITY_PATHS=/opt/app/neuraledge/branding/persona \
    NEURALEDGE_THEME_PATH=/opt/app/neuraledge/branding/theme.toml \
    NEURALEDGE_BRANDING_ENABLED=1
